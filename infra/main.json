          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for SignalR Service"
              }
            },
            "environmentName": {
              "type": "string",
              "metadata": {
                "description": "Environment name (dev, staging, prod)"
              }
            },
            "appName": {
              "type": "string",
              "metadata": {
                "description": "Application name prefix"
              }
            },
            "privateEndpointName": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Name of the SignalR private endpoint (for networkACL reference)"
              }
            }
          },
          "variables": {
            "signalRName": "[format('{0}-{1}-signalr', parameters('appName'), parameters('environmentName'))]"
          },
          "resources": [
            {
              "type": "Microsoft.SignalRService/signalR",
              "apiVersion": "2024-03-01",
              "name": "[variables('signalRName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Standard_S1",
                "tier": "Standard",
                "capacity": 1
              },
              "kind": "SignalR",
              "properties": {
                "features": [
                  {
                    "flag": "ServiceMode",
                    "value": "Serverless"
                  },
                  {
                    "flag": "EnableConnectivityLogs",
                    "value": "True"
                  }
                ],
                "cors": {
                  "allowedOrigins": [
                    "*"
                  ]
                },
                "publicNetworkAccess": "Enabled",
                "networkACLs": {
                  "defaultAction": "Deny",
                  "publicNetwork": {
                    "allow": [
                      "ClientConnection"
                    ]
                  },
                  "privateEndpoints": "[if(not(empty(parameters('privateEndpointName'))), createArray(createObject('name', parameters('privateEndpointName'), 'allow', createArray('ServerConnection', 'ClientConnection'))), createArray())]"
                }
              },
              "tags": {
                "environment": "[parameters('environmentName')]",
                "app": "[parameters('appName')]"
              }
            }
          ],
          "outputs": {
            "hostname": {
              "type": "string",
              "metadata": {
                "description": "SignalR Service hostname"
              },
              "value": "[reference(resourceId('Microsoft.SignalRService/signalR', variables('signalRName')), '2024-03-01').hostName]"
            },
            "connectionString": {
              "type": "string",
              "metadata": {
                "description": "SignalR connection string"
              },
              "value": "[listKeys(resourceId('Microsoft.SignalRService/signalR', variables('signalRName')), '2024-03-01').primaryConnectionString]"
            },
            "name": {
              "type": "string",
              "metadata": {
                "description": "SignalR resource name"
              },
              "value": "[variables('signalRName')]"
            },
            "resourceId": {
              "type": "string",
              "metadata": {
                "description": "SignalR resource ID"
              },
              "value": "[resourceId('Microsoft.SignalRService/signalR', variables('signalRName'))]"
            }
          }
        }
      }
    },
