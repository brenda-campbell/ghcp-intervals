                    "properties": {
                      "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.service.signalr.net')]"
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.service.signalr.net')]",
                "[resourceId('Microsoft.Network/privateEndpoints', variables('signalRPrivateEndpointName'))]"
              ]
            }
          ],
          "outputs": {
            "signalRPrivateEndpointName": {
              "type": "string",
              "metadata": {
                "description": "Name of the SignalR private endpoint (needed for networkACL reference)"
              },
              "value": "[variables('signalRPrivateEndpointName')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'deploy-cosmosDb')]",
        "[resourceId('Microsoft.Resources/deployments', 'deploy-networking')]",
        "[resourceId('Microsoft.Resources/deployments', 'deploy-signalR')]"
      ]
    }
  ],
  "outputs": {
    "cosmosDbEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Cosmos DB endpoint"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deploy-cosmosDb'), '2025-04-01').outputs.endpoint.value]"
    },
    "signalRConnectionString": {
      "type": "string",
      "metadata": {
        "description": "SignalR connection string"
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deploy-signalR'), '2025-04-01').outputs.connectionString.value]"
    }
  }
}